{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemastore.org/sarif-2.1.0.json",
  "type": "object",
  "required": [
    "version",
    "runs"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "2.1.0"
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "results"
        ],
        "properties": {
          "tool": {
            "type": "object",
            "required": [
              "driver"
            ],
            "properties": {
              "driver": {
                "type": "object",
                "required": [
                  "name",
                  "rules"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "properties"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "properties": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ruleId",
                "message",
                "locations",
                "partialFingerprints",
                "properties"
              ],
              "properties": {
                "ruleId": {
                  "type": "string"
                },
                "locations": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "partialFingerprints": {
                  "type": "object"
                },
                "properties": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
